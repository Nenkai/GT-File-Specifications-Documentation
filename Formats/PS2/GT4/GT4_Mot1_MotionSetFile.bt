} CurveSetIndex <read=Index>;

typedef struct // GT4_Motion::MotionSetFactor
{
    short MotionCount <fgcolor=cGreen>;
    short PlaylistCount <fgcolor=cGreen>;
    OffsetT MotionsOffset;
    OffsetT PlaylistsOffset;
    OffsetT CommandsOffset;
    
    for (local int j = 0; j < MotionCount; j++)
    {
        FSeek(startof(MotionSetFile) + MotionsOffset + (j * 0x20));
        Motion Motion_;
    }
    
    for (local int j = 0; j < PlaylistCount; j++)
    {
        FSeek(startof(MotionSetFile) + PlaylistsOffset + (j * 0x20));
        Playlist Playlist_;
    }
    
    FSeek(startof(MotionSetFile) + CommandsOffset);
    struct
    {
        local int exit = false;
        while (!exit)
        {
            struct
            {
                enum <byte>
                {
                    MotionCommand_Finish = 1,
                    MotionCommand_PushMatrix = 2,
                    MotionCommand_PopMatrix = 3,
                    MotionCommand_Exe = 4,
                    MotionCommand_Translate = 5,
                    MotionCommand_RotateX = 6,
                    MotionCommand_RotateY = 7,
                    MotionCommand_RotateZ = 8,
                    MotionCommand_Scale = 9,
                    MotionCommand_FoV = 10,
                    MotionCommand_LookAt = 11,
                    MotionCommand_LightDiffuse = 12,
                    MotionCommand_LightAmbient = 13,
                    MotionCommand_LightSpecular = 14,
                    MotionCommand_LightPosition = 15,
                    MotionCommand_Vector1 = 16,
                    MotionCommand_Vector2 = 17,
                    MotionCommand_Vector3 = 18,
                    MotionCommand_RotateQuat = 19,
                } MotionCommandType;
                
                if (MotionCommandType == 0)
                {
                    exit = true;
                    break;   
                }
                
                switch (MotionCommandType)
                {
                    case MotionCommand_Finish:
                    case MotionCommand_PushMatrix:
                    case MotionCommand_PopMatrix:
                        break;
                        
                    case MotionCommand_Exe:
                        {
                            string Name;
                        }
                        break;
                        
                    case MotionCommand_Translate:
                        {
                            byte Bitmask <format=binary>;
                            CurveSetIndex XCurve((Bitmask >> 0) & 1);
                            CurveSetIndex YCurve((Bitmask >> 1) & 1);
                            CurveSetIndex ZCurve((Bitmask >> 2) & 1);
                        }
                        break;
                        
                    case MotionCommand_RotateX:
                    case MotionCommand_RotateY:
                    case MotionCommand_RotateZ:
                        {
                            byte Bitmask <format=binary>;
                            CurveSetIndex Value_((Bitmask >> 0) & 1);
                        }
                        break;
                        
                    case MotionCommand_Scale:
                        {
                            byte Bitmask <format=binary>;
                            CurveSetIndex XCurveSet((Bitmask >> 0) & 1);
                            CurveSetIndex YCurveSet((Bitmask >> 1) & 1);
                            CurveSetIndex ZCurveSet((Bitmask >> 2) & 1);
                        }
                        break;
                    
                    case MotionCommand_FoV:
                        {
                            byte Bitmask <format=binary>;
                            CurveSetIndex CurveSet_((Bitmask >> 0) & 1);
                        }
                        break;
                        
                     case MotionCommand_LookAt:
                        {
                            byte Bitmask <format=binary>;
                            CurveSetIndex XCurveSet((Bitmask >> 0) & 1);
                            CurveSetIndex YCurveSet((Bitmask >> 1) & 1);
                            CurveSetIndex ZCurveSet((Bitmask >> 2) & 1);
                            
                            CurveSetIndex X2CurveSet((Bitmask >> 3) & 1);
                            CurveSetIndex Y2CurveSet((Bitmask >> 4) & 1);
                            CurveSetIndex Z2CurveSet((Bitmask >> 5) & 1);
                            
                            CurveSetIndex X3CurveSet((Bitmask >> 6) & 1);
                            CurveSetIndex Y3CurveSet((Bitmask >> 7) & 1);
                            CurveSetIndex Z3CurveSet((Bitmask >> 8) & 1);
                        }
                        break;
                        
                    case MotionCommand_LightDiffuse:
                    case MotionCommand_LightAmbient:
                    case MotionCommand_LightSpecular:
                        {
                            byte Bitmask <format=binary>;
                            CurveSetIndex RCurveSet((Bitmask >> 0) & 1);
                            CurveSetIndex GCurveSet((Bitmask >> 1) & 1);
                            CurveSetIndex BCurveSet((Bitmask >> 2) & 1);
                            CurveSetIndex ACurveSet((Bitmask >> 3) & 1);
                        }
                        break;
                        
                    case MotionCommand_LightPosition:
                        {
                            byte Bitmask <format=binary>;
                            CurveSetIndex XCurveSet((Bitmask >> 0) & 1);
                            CurveSetIndex YCurveSet((Bitmask >> 1) & 1);
                            CurveSetIndex ZCurveSet((Bitmask >> 2) & 1);
                        }
                        break;
                        
                    case MotionCommand_Vector1:
                        {
                            byte Bitmask <format=binary>;
                            string Name;
                            CurveSetIndex Vec1CurveSet((Bitmask >> 0) & 1);
                        }
                        break;
                        
                    case MotionCommand_Vector2:
                        {
                            byte Bitmask <format=binary>;
                            string Name;
                            CurveSetIndex Vec1CurveSet((Bitmask >> 0) & 1);
                            CurveSetIndex Vec2CurveSet((Bitmask >> 1) & 1);
                        }
                        break;
                    case MotionCommand_Vector3:
                        {
                            byte Bitmask <format=binary>;
                            string Name;
                            CurveSetIndex Vec1CurveSet((Bitmask >> 0) & 1);
                            CurveSetIndex Vec2CurveSet((Bitmask >> 1) & 1);
                            CurveSetIndex Vec3CurveSet((Bitmask >> 2) & 1);
                        }
                        break;
                        
                    case MotionCommand_RotateQuat:
                        {
                            byte Bitmask <format=binary>;
                            CurveSetIndex XCurveSet((Bitmask >> 0) & 1);
                            CurveSetIndex YCurveSet((Bitmask >> 1) & 1);
                            CurveSetIndex ZCurveSet((Bitmask >> 2) & 1);
                        }
                        break;
                    default:
                        break;
                }
            } Command <read=Str("%s", EnumToString(MotionCommandType) + (exists(Name) ? " ("+Name+")" : ""))>;
        }
    } Commands;
    
    FSeek(startof(this) + 0x10);
} Factor;
        
